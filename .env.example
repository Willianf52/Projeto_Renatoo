# Credenciais do projeto Supabase.
# Painel: Project Settings > API  (ou Project Settings > API Keys)
#
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
# NUNCA ponha a service_role key numa variavel NEXT_PUBLIC_*: tudo que tem esse
# prefixo e embutido no bundle do navegador, e a service_role ignora todas as
# politicas de RLS. Ela tem variavel propria mais abaixo, sem o prefixo.

NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# E-mail transacional (aviso de troca de senha) via Resend (resend.com).
# Painel: API Keys > Create API Key (permissao "Sending access" basta).
RESEND_API_KEY=re_sua_api_key_aqui

# Qualquer string aleatoria; o mesmo valor vai num header do Database Webhook
# configurado no Supabase (Database > Webhooks), pra rota so aceitar chamadas
# que vieram de la.
SUPABASE_WEBHOOK_SECRET=gere_uma_string_aleatoria_aqui

# --- Importacao de coletas (POST /api/importar/coletas) ---------------------
#
# `visitas` e `leituras` so tem policy de SELECT (migrations 0003/0004): a
# escrita passa pela service_role, no servidor. Sem estas duas variaveis a rota
# de importacao responde 500 e o resto do app continua funcionando normalmente.
#
# Painel: Project Settings > API Keys > service_role. Trata-se de uma chave que
# ignora TODAS as politicas de RLS -- nao versione, nao mande pro navegador.
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Qualquer string aleatoria. Vai no header `x-importacao-secret` de quem envia
# os lotes; sem conferir, a rota responde 401.
IMPORTACAO_SECRET=gere_uma_string_aleatoria_aqui
