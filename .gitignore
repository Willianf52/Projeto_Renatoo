# dependencies
/node_modules
# monorepo: pnpm cria um node_modules por pacote do workspace
apps/*/node_modules
packages/*/node_modules
# O gerenciador do projeto e o pnpm (pnpm-lock.yaml). Um package-lock.json
# junto resolve versoes por conta propria e diverge do lock oficial.
/package-lock.json
/.pnpm-store
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# typescript
*.tsbuildinfo
next-env.d.ts

# agent skills (conteudo baixado e symlink local; skills-lock.json e versionado)
/.agents/
# `/*` (nao `/`) de proposito: um ignore de diretorio com barra bloqueia git
# de recursar nele, e nenhuma negacao depois resgata algo dentro de um pai
# assim excluido. Como glob do conteudo, cada item vira um alvo negavel.
/.claude/skills/*
# excecao: skills autorais deste projeto (nao baixadas de plugin), versionadas
# de proposito para todo mundo que abrir o repo com Claude Code ganhar o
# mesmo contexto de arquitetura/seguranca/testes.
!/.claude/skills/nextjs-architecture-patterns/
!/.claude/skills/supabase-rls-security/
!/.claude/skills/testing-vitest-pgtap-playwright/

# gerados automaticamente pelo Next.js (agentRules) a cada dev/build
/AGENTS.md
/CLAUDE.md

# Sentry Config File
.env.sentry-build-plugin
