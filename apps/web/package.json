{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:leve": "vitest run --maxWorkers=1 --no-isolate",
    "test:cobertura": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:desempenho": "playwright test -c playwright.desempenho.config.ts",
    "test:carga": "playwright test -c playwright.carga.config.ts",
    "test:e2e:leve": "playwright test -c playwright.leve.config.ts",
    "test:responsividade": "playwright test -c playwright.leve.config.ts --project=responsividade",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@projeto-renatoo/shared": "workspace:*",
    "@sentry/nextjs": "^10.76.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "~16.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^25.9.9",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
