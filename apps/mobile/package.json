{
  "name": "mobile",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "vitest run",
    "test:leve": "vitest run --maxWorkers=1 --no-isolate",
    "test:cobertura": "vitest run --coverage",
    "atualizar:preview": "npx -y eas-cli@latest update --channel preview --environment preview --platform android",
    "atualizar:producao": "npx -y eas-cli@latest update --channel production --environment production --platform android",
    "atualizar:source-maps": "node scripts/enviar-source-maps.mjs dist",
    "apresentar": "node scripts/apresentar.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@projeto-renatoo/shared": "workspace:*",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "@sentry/react-native": "~8.28.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~58.0.19",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.18",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.6",
    "@types/react": "~19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
