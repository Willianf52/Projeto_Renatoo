# Copie para .env e preencha com os valores do projeto Supabase.
#
# EXPO_PUBLIC_* e embutido no bundle e vai para o aparelho -- so pode conter
# valor publico. A chave anonima e publica por design: quem protege os dados e
# o RLS, nao o segredo da chave.
#
# A chave `service_role` NAO entra aqui em hipotese nenhuma: ela ignora RLS e
# seria extraivel de um APK publicado.
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Endereco do painel web, sem barra no fim. Opcional: preenchido, a tela de
# login mostra "Perdeu sua Senha?" abrindo /recuperar-senha no navegador --
# a recuperacao mora no painel, o app so aponta para ela.
EXPO_PUBLIC_URL_DO_PORTAL=https://seu-painel.vercel.app

# Roteiro do marco 03 do plano "Abrindo o Portao" -- a prova do fluxo offline
# (fila em SQLite, sync, reenvio sem duplicar). Com MARCO_03=1 o app NAO abre:
# `index.ts` monta o roteiro no lugar dele, e a saida vai para o console
# (`adb logcat | grep MARCO03`) e para uma lista crua na tela.
#
# Deixe em 0 no dia a dia. As tres variaveis abaixo so sao lidas quando ele
# esta ligado, e a conta precisa ter cargo INSPETOR ativo -- a policy da
# migration 0036 exige sessao real, nao ha atalho.
EXPO_PUBLIC_ROTEIRO_MARCO_03=0
EXPO_PUBLIC_ROTEIRO_EMAIL=inspetor@exemplo.com
EXPO_PUBLIC_ROTEIRO_SENHA=a_senha_da_conta_de_teste
# Site onde a ronda de teste e gravada -- use um site dedicado a homologacao,
# porque as linhas entram no banco de verdade e precisam ser apagadas depois.
EXPO_PUBLIC_ROTEIRO_SITE_ID=30
