{
  "name": "performance-lab-login",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter web test:e2e",
    "check:env": "pnpm --filter web check:env",
    "lint": "eslint .",
    "test:db": "supabase test db --local supabase/tests/database",
    "types:generate": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "types:generate:remoto": "supabase gen types typescript --project-id wcmqmeikpwwpwyztqwni --schema public > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "supabase": "^2.115.0",
    "typescript": "^5"
  }
}
